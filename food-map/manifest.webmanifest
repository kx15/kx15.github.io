{
  "name": "Makan Map",
  "short_name": "Makan Map",
  "description": "Save Instagram food recommendations to a map and send them to Google Maps.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0A0E1E",
  "theme_color": "#0A0E1E",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
